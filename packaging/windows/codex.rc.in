// Recursos de Windows: el icono que enseñan la barra de tareas, el Explorador
// y el instalador, más la ficha de "Propiedades" del .exe. Lo genera CMake
// (configure_file) para que la versión salga de una sola parte.
#include <windows.h>

// El primer icono por número es el que Windows usa como icono del programa.
IDI_ICON1 ICON "@CODEX_WIN_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @CODEX_VERSION_MAJOR@,@CODEX_VERSION_MINOR@,@CODEX_VERSION_PATCH@,0
PRODUCTVERSION @CODEX_VERSION_MAJOR@,@CODEX_VERSION_MINOR@,@CODEX_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   // inglés (EE. UU.), Unicode
        BEGIN
            VALUE "CompanyName",      "Stride"
            VALUE "FileDescription",  "Codex - sticky notes for the desktop"
            VALUE "FileVersion",      "@CODEX_VERSION@.0"
            VALUE "InternalName",     "codex"
            VALUE "OriginalFilename", "codex.exe"
            VALUE "ProductName",      "Codex"
            VALUE "ProductVersion",   "@CODEX_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
