<?xml version="1.0" encoding="UTF-8"?>
<!-- La ficha que leen las tiendas de aplicaciones. El id, el launchable y el
     nombre del icono salen todos de TAGOROR_APP_ID: si dejan de coincidir, la
     tienda muestra la aplicación sin icono o no la relaciona con su ventana. -->
<component type="desktop-application">
  <id>@TAGOROR_APP_ID@</id>

  <name>Tagoror</name>
  <summary>Sticky notes for the desktop</summary>
  <summary xml:lang="es">Notas pegadas al escritorio</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <!-- metadata_license es la de esta ficha; project_license, la del programa
       (el fichero LICENSE de la raíz). Flathub exige las dos. -->
  <project_license>MIT</project_license>

  <developer id="io.github.larzt">
    <name>Alejandro</name>
  </developer>

  <description>
    <p>
      A frameless, translucent notes panel that sits on the desktop instead of
      getting in the way: text notes, checklists with progress, reminders that
      actually ring, voice notes with a waveform, and links you can attach to
      any of them.
    </p>
    <p xml:lang="es">
      Un panel de notas sin marco y translúcido, pensado para vivir en el
      escritorio en vez de estorbar: notas de texto, listas con progreso,
      recordatorios que suenan de verdad, notas de voz con su onda y enlaces
      en cualquiera de ellas.
    </p>
    <ul>
      <li>Reminders with a month view, and an alarm that keeps ringing until you stop it</li>
      <li>Voice notes recorded straight from the microphone, with live levels</li>
      <li>Folds into a 56px dock, or hides in the system tray</li>
      <li>Interface in Spanish or English</li>
    </ul>
  </description>

  <launchable type="desktop-id">@TAGOROR_APP_ID@.desktop</launchable>

  <!-- Hasta esta versión la aplicación se llamaba Codex (Códice en español).
       provides deja que se la siga encontrando por el ID viejo y replaces le
       dice a la tienda que la instalación anterior es esta misma, no otra. -->
  <provides>
    <id>io.github.larzt.codex</id>
  </provides>
  <replaces>
    <id>io.github.larzt.codex</id>
  </replaces>

  <screenshots>
    <screenshot type="default">
      <caption>The panel with a checklist, a reminder, a voice note and a text note</caption>
      <image>https://raw.githubusercontent.com/Larzt/tagoror/main/docs/panel.png</image>
    </screenshot>
    <screenshot>
      <caption>The month view</caption>
      <image>https://raw.githubusercontent.com/Larzt/tagoror/main/docs/calendar.png</image>
    </screenshot>
    <screenshot>
      <caption>Settings</caption>
      <image>https://raw.githubusercontent.com/Larzt/tagoror/main/docs/settings.png</image>
    </screenshot>
    <screenshot>
      <caption>Backups: on demand, on a schedule, and a list to go back to</caption>
      <image>https://raw.githubusercontent.com/Larzt/tagoror/main/docs/backups.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/Larzt/tagoror</url>
  <url type="bugtracker">https://github.com/Larzt/tagoror/issues</url>

  <categories>
    <category>Utility</category>
  </categories>

  <keywords>
    <keyword>notes</keyword>
    <keyword>checklist</keyword>
    <keyword>reminder</keyword>
    <keyword>calendar</keyword>
    <keyword translate="no">tagoror</keyword>
    <!-- El nombre anterior, para quien lo busque por él. -->
    <keyword translate="no">codex</keyword>
    <keyword xml:lang="es">notas</keyword>
    <keyword xml:lang="es">recordatorio</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="2.0.0" date="2026-09-18">
      <description>
        <p>Birthdays. A page of their own: the next one due is highlighted,
           the rest are listed under month separators, and each person can
           have a reminder that rings on the day. The list can be ordered by
           how long is left or by the calendar, January to December.</p>
        <p>Settings are now a page instead of a dropdown, with the accent,
           the opacity, the language, the window options, the storage folder,
           the backups and the microphone all in one place. The header names
           the page you are on and Escape closes it.</p>
        <p>Checklist items can be renamed. Also fixes a bug where an item
           made of one long unbroken word clipped every card in the list.</p>
      </description>
    </release>
    <release version="1.5.0" date="2026-09-07">
      <description>
        <p>Backups. A copy of the notes file is set aside before it is
           overwritten, on a schedule you choose — how often and at what
           time — plus a copy on demand and a list to go back to. The ten
           most recent are kept, inside the storage folder, so they travel
           with the notes.</p>
        <p>Fixes a bug that could lose notes: a storage folder on a volume
           that was not mounted made the app believe it was a fresh install
           and overwrite the real file once the volume appeared. A folder
           that is not there is no longer created, a file that cannot be
           read is never overwritten, and saving is now atomic. The panel
           says so while the folder is missing, and picks it up on its own
           when it comes back.</p>
      </description>
    </release>
    <release version="1.3.1" date="2026-08-23"/>
    <release version="1.3.0" date="2026-08-21"/>
    <release version="1.2" date="2026-08-21">
      <description>
        <p>Language selector (Spanish/English), a system tray icon, and a panel
           that folds and unfolds without wandering off its corner.</p>
      </description>
    </release>
    <release version="1.1" date="2026-08-21"/>
    <release version="1.0" date="2026-08-21"/>
  </releases>
</component>
